# ==========================================
# Configuración Base de Datos (PostgreSQL)
# ==========================================
POSTGRES_USER=kroser
POSTGRES_PASSWORD=kroser
POSTGRES_DB=kroserbot
POSTGRES_PORT=5432
DATABASE_URL=postgres://kroser:kroser@localhost:5432/kroserbot

# ==========================================
# Configuración Redis (Memoria de Sesión)
# ==========================================
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ==========================================
# Integración Chatwoot
# ==========================================
CHATWOOT_API_URL=https://app.chatwoot.com
CHATWOOT_API_TOKEN=tu_api_token_aqui
CHATWOOT_ACCOUNT_ID=1

# ==========================================
# LLM Providers Keys (Gemini / OpenAI)
# ==========================================
GEMINI_API_KEY=tu_gemini_api_key_aqui
OPENAI_API_KEY=tu_openai_api_key_aqui

# ==========================================
# Backend & App Config
# ==========================================
NODE_ENV=development
PORT=3000
DEBOUNCE_WAIT_MS=8000

# ==========================================
# Seguridad — OBLIGATORIO (el servidor no arranca sin estas vars)
# ==========================================
# Usuario y contraseña del panel admin (NO usar defaults, cambiar en produccion)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar_esta_password_2026
# Usuario y contraseña del panel deposito
DEPOSITO_USER=deposito
DEPOSITO_PASSWORD=cambiar_esta_password_2026
# Secret para firmar JWT (minimo 32 caracteres, generar con: openssl rand -hex 32)
JWT_SECRET=generar_con_openssl_rand_hex_32_minimo_32_chars_aqui
# Credenciales Basic Auth para el webhook de Chatwoot (formato usuario:password)
WEBHOOK_BASIC_AUTH=kroser:cambiar_esta_password
# Origenes permitidos para CORS separados por coma (vacio = sin CORS)
CORS_ORIGINS=http://localhost:3000,https://admin.kroser.com.uy

# ==========================================
# Fuente de Datos de Ingestión (Tarea 02b)
# ==========================================
# opciones: scraping | sql_directo | api
KROSER_DATA_SOURCE=scraping
KROSER_FALLBACK_SCRAPING=true

# Conector SQL Directo (opcional)
KROSER_DB_TYPE=postgresql
KROSER_DB_HOST=localhost
KROSER_DB_PORT=5432
KROSER_DB_USER=readonly_kroser
KROSER_DB_PASS=secret_pass
KROSER_DB_NAME=kroser_erp

# Conector API REST (opcional)
KROSER_API_URL=https://api.kroser.com.uy/v1/products
KROSER_API_KEY=tu_api_key_de_kroser_aqui

# ==========================================
# Integración MercadoPago (desactivada por defecto)
# ==========================================
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui
MERCADOPAGO_PUBLIC_KEY=tu_public_key_aqui
MERCADOPAGO_WEBHOOK_SECRET=tu_webhook_secret_aqui
MERCADOPAGO_WEBHOOK_URL=https://api.kroser.com.uy/mercadopago/webhook
MERCADOPAGO_SUCCESS_URL=https://kroser.com.uy/checkout/success
MERCADOPAGO_FAILURE_URL=https://kroser.com.uy/checkout/failure
MERCADOPAGO_PENDING_URL=https://kroser.com.uy/checkout/pending

