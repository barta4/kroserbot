# ==========================================================
# KroserBot - Variables de Entorno para Dokploy
# Dominio: venta.kroser.uy
# Copiar estas variables en la pestaña "Environment" de Dokploy
# ==========================================================

# Base de Datos PostgreSQL
POSTGRES_USER=kroser
POSTGRES_PASSWORD=kroser_secure_password_2026
POSTGRES_DB=kroserbot

# Seguridad y Accesos al Panel de Control
ADMIN_USER=admin
ADMIN_PASSWORD=kroser2026
DEPOSITO_USER=deposito
DEPOSITO_PASSWORD=deposito2026
JWT_SECRET=kroserbot_jwt_secret_key_2026_super_secure_min_32_chars
WEBHOOK_BASIC_AUTH=kroser:kroser2026

# Modelos de Inteligencia Artificial (completar con su API Key)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Integración con Uruchat / Chatwoot
CHATWOOT_API_URL=https://app.uruchat.com
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1

# Pasarela de Pago MercadoPago (Opcional)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_WEBHOOK_SECRET=

# Notificaciones por Correo SMTP (Opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=pedidos@kroser.com.uy
