# Copiar a .env y completar valores.
# Usar junto al docker-compose de la tarea 00 (Postgres + Redis).

# Cadena de conexión Postgres (pgvector)
DATABASE_URL=postgresql://kroker:kroker@localhost:5432/kroserbot

# Sitio
KROSER_BASE_URL=https://www.kroser.com.uy

# Delays con jitter (segundos)
KROSER_DELAY_MIN=6
KROSER_DELAY_MAX=11

# Claves LLM (para la tarea 03-embeddings-rag)
OPENAI_API_KEY=
GEMINI_API_KEY=